# Copy to .env - every setting is optional.

# Optional AI coach. Without a key the coach endpoint uses a rule-based summary.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5

# Frontend origin(s), comma-separated. "*" is fine for the hackathon.
CORS_ORIGINS=*

# Demo data: seed Alex & Jordan from Kaggle on first start, shifted so history ends yesterday.
SEED_DEMO_USERS=true
SHIFT_DEMO_TO_TODAY=true

# Forecast engine
SIMULATIONS=1000
DEFAULT_HORIZON_DAYS=180
CURRENCY_SYMBOL=£

# Chat assistant (RAG over the user's data + confirmable actions). Small and cheap on purpose.
CHAT_MODEL=claude-haiku-5-5

# Call mode (voice). Get a key at elevenlabs.io > Developers > API keys.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ZF6FPAbjXT4488VcRRnw
ELEVENLABS_MODEL=eleven_flash_v2_5

# Name of the chat/call assistant (Lydia, after Lydia Becker, Manchester suffrage pioneer)
ASSISTANT_NAME=Lydia
