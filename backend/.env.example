# Copy to .env - every setting is optional.

# Optional AI coach. Without a key the coach endpoint uses a rule-based summary.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5

# Frontend origin(s), comma-separated. "*" is fine for the hackathon.
CORS_ORIGINS=*

# Demo data: seed Alex & Jordan from Kaggle on first start, shifted so history ends yesterday.
SEED_DEMO_USERS=true
SHIFT_DEMO_TO_TODAY=true

# Forecast engine
SIMULATIONS=1000
DEFAULT_HORIZON_DAYS=180
CURRENCY_SYMBOL=£
